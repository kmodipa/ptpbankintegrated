@page "{clientCode:int}"
@using PTPBank.Domain.Enums
@model PTPBank.Web.Pages.Accounts.CreateModel
@{
    ViewData["Title"] = "Open Account";
}

<nav aria-label="breadcrumb" class="breadcrumb-wrap">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-page="/Persons/Index">Persons</a></li>
        <li class="breadcrumb-item"><a asp-page="/Accounts/Index" asp-route-clientCode="@Model.Input.ClientCode">Accounts</a></li>
        <li class="breadcrumb-item active" aria-current="page">Open Account</li>
    </ol>
</nav>

<div class="surface-panel form-panel">
    <h1 class="page-title">Open Account</h1>
    <p class="text-muted">Person Code: @Model.Input.ClientCode</p>

    <form method="post" id="openAccountForm">
        <input type="hidden" asp-for="Input.ClientCode" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Input.AccountNumber" class="form-label"></label>
            <input asp-for="Input.AccountNumber" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Input.AccountType" class="form-label"></label>
            <select asp-for="Input.AccountType" class="form-select" asp-items="Html.GetEnumSelectList<AccountType>()"></select>
        </div>

        <div class="mb-3">
            <label asp-for="Input.OpeningDeposit" class="form-label"></label>
            <input asp-for="Input.OpeningDeposit" class="form-control" />
            <small class="text-muted">Savings minimum: R200, Cheque minimum: R500</small>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Open</button>
            <a class="btn btn-outline-secondary" asp-page="Index" asp-route-clientCode="@Model.Input.ClientCode">Back to Accounts</a>
        </div>
    </form>
</div>
