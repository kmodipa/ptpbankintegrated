@page "{accountCode:int}"
@using PTPBank.Domain.Enums
@model PTPBank.Web.Pages.Transactions.IndexModel
@{
    ViewData["Title"] = "Transactions";
}

<nav aria-label="breadcrumb" class="breadcrumb-wrap">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-page="/Persons/Index">Persons</a></li>
        <li class="breadcrumb-item"><a asp-page="/Accounts/Index" asp-route-clientCode="@Model.ClientCode">Accounts</a></li>
        <li class="breadcrumb-item active" aria-current="page">Transactions</li>
    </ol>
</nav>

<div class="surface-panel">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="page-title">Transaction Management</h1>
            <p class="text-muted mb-0">Account Code: @Model.AccountCode</p>
            <h5>Current Balance: R <span id="currentBalance">@Model.CurrentBalance.ToString("N2")</span></h5>
        </div>
        <a class="btn btn-outline-secondary" asp-page="/Accounts/Index" asp-route-clientCode="@Model.ClientCode">Back to Accounts</a>
    </div>

    <div class="surface-panel mb-3">
        <h5>Add Transaction</h5>
        <form method="post" id="transactionForm">
            <input type="hidden" asp-for="Input.AccountCode" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Input.TransactionDate" class="form-label"></label>
                    <input asp-for="Input.TransactionDate" class="form-control js-datepicker" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.TransactionType" class="form-label"></label>
                    <select asp-for="Input.TransactionType" class="form-select" asp-items="Html.GetEnumSelectList<TransactionType>()"></select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.Amount" class="form-label"></label>
                    <input asp-for="Input.Amount" class="form-control" id="amountInput" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Projected Balance</label>
                    <input class="form-control" id="projectedBalance" readonly />
                </div>
                <div class="col-md-12">
                    <label asp-for="Input.Description" class="form-label"></label>
                    <input asp-for="Input.Description" class="form-control" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary mt-3">Post Transaction</button>
        </form>
    </div>

    <table class="table table-striped app-table">
        <thead>
            <tr>
                <th>Transaction Date</th>
                <th>Capture Date</th>
                <th>Type</th>
                <th class="text-end">Amount (R)</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Transactions)
        {
            <tr>
                <td>@item.TransactionDate.ToString("yyyy-MM-dd")</td>
                <td>@item.CaptureDate.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@item.TransactionType</td>
                <td class="text-end">@item.Amount.ToString("N2")</td>
                <td>@item.Description</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    $(function(){
        $('.js-datepicker').datepicker({ dateFormat: 'yy-mm-dd', maxDate: 0 });

        function calcProjected() {
            const current = parseFloat($('#currentBalance').text().replace(/,/g, '')) || 0;
            const amount = parseFloat($('#amountInput').val()) || 0;
            const type = $('#Input_TransactionType').val();
            const projected = type === 'Debit' ? current - Math.abs(amount) : current + Math.abs(amount);
            $('#projectedBalance').val(projected.toFixed(2));
        }

        $('#amountInput, #Input_TransactionType').on('input change', calcProjected);
        calcProjected();

        $('#transactionForm').on('submit', function(){
            setTimeout(function(){
                $.get('?handler=Balance', function(res){
                    $('#currentBalance').text(parseFloat(res.balance).toFixed(2));
                });
            }, 400);
        });
    });
</script>
}
