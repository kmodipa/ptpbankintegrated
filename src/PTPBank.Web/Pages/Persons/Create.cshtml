@page
@model PTPBank.Web.Pages.Persons.CreateModel
@{
    ViewData["Title"] = "Create Person";
}

<nav aria-label="breadcrumb" class="breadcrumb-wrap">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-page="/Persons/Index">Persons</a></li>
        <li class="breadcrumb-item active" aria-current="page">Create</li>
    </ol>
</nav>

<div class="surface-panel form-panel">
    <h1 class="page-title">Create Person</h1>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Input.Name" class="form-label"></label>
            <input asp-for="Input.Name" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Input.Surname" class="form-label"></label>
            <input asp-for="Input.Surname" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Input.IDNumber" class="form-label"></label>
            <input asp-for="Input.IDNumber" class="form-control" />
            <span asp-validation-for="Input.IDNumber" class="text-danger"></span>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Save</button>
            <a class="btn btn-outline-secondary" asp-page="Index">Back to Persons</a>
        </div>
    </form>
</div>
